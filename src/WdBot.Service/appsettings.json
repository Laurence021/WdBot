{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning",
      "WdBot.Messages": "Information",
      "WdBot.Messages.Private": "Information",
      "WdBot.Messages.Channel": "Information",
      "WdBot.Messages.Unhandled": "Information"
    }
  },
  "FileLogging": {
    "Directory": "logs",
    "MessageDirectory": "logs/messages"
  },
  "Backend": {
    "Url": "ws://localhost:5080/ws/bot-service",
    "ApiKey": "",
    "ServiceInstanceId": "wdbot-01",
    "ReconnectMinSeconds": 1,
    "ReconnectMaxSeconds": 30,
    "OutboxCapacity": 10000
  },
  "Game": {
    "UnityVersion": "2022.3.20f1",
    "DefaultPhoneModel": "",
    "RequestHeaders": {
      "Http": {
        "User-Agent": "UnityPlayer/{unity_version} (UnityWebRequest/1.0, libcurl/8.5.0-DEV)",
        "X-Unity-Version": "{unity_version}",
        "Accept": "*/*",
        "Accept-Encoding": "deflate, gzip",
        "Content-Type": "application/json"
      },
      "WebSocket": {
        "User-Agent": "UnityPlayer/{unity_version} (UnityWebRequest/1.0, libcurl/8.5.0-DEV)",
        "X-Unity-Version": "{unity_version}"
      }
    },
    "Environments": {
      "prod": {
        "ApiBaseUrl": "",
        "ChatWsUrl": ""
      },
      "test": {
        "ApiBaseUrl": "",
        "ChatWsUrl": ""
      }
    }
  },
  "Bot": {
    "TokenRefreshIntervalMinutes": 50,
    "DuplicateLoginCooldownSeconds": 300,
    "MaintenanceBackoffSeconds": 120,
    "ChatReconnectMaxSeconds": 60,
    "SendReplyTimeoutSeconds": 10,
    "SendQueueCapacity": 1000,
    "RestartMaxDelaySeconds": 300,
    "HttpTimeoutSeconds": 20,
    "OneBotPerChannel": true,
    "ChannelCollisionMaxAttempts": 10,
    "ChannelCollisionRetrySeconds": 5,
    "ChannelWaitingRetrySeconds": 300,
    "ChannelRescanMinutes": 10,
    "WriteRosterFile": true
  }
}
