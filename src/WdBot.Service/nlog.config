<?xml version="1.0" encoding="utf-8"?>
<!--
  WdBot 的 NLog 設定：負責「寫到哪裡、長什麼樣子」。
  - 記錄等級由 appsettings 的 Logging:LogLevel 控制（例如 WdBot.Messages.Private／WdBot.Messages.Channel 設為 Debug 才會寫私訊／公頻內容），這裡的規則不再篩等級
  - 資料夾由 appsettings 的 FileLogging 決定，程式啟動時放進 ${gdc:LogDirectory}、${gdc:MessageDirectory}
  - 訊息內容 log 依機器人分資料夾，資料夾名稱來自 log scope 的 BotId
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsoleError="true">

  <variable name="logDir" value="${gdc:item=LogDirectory:whenEmpty=${basedir}/logs}" />
  <variable name="messageDir" value="${gdc:item=MessageDirectory:whenEmpty=${basedir}/logs/messages}" />
  <variable name="botFolder" value="${scopeproperty:item=BotId:whenEmpty=unknown}" />
  <variable name="exceptionText" value="${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <!--
      主控台：時間 [等級] 類別: 訊息。WdColoredConsole 是程式自訂的輸出（TemplateColoredConsoleTarget），
      比照 Serilog 依參數型別上色：字串青色、數字洋紅色、true/false 與 null 藍色、其他型別綠色。格式由程式產生，不需要 layout。
      想改回 NLog 內建的主控台輸出，換成：
      <target xsi:type="ColoredConsole" name="console"
              layout="${date:format=HH\:mm\:ss} [${level:format=TriLetter:uppercase=true}] ${logger}: ${message}${exceptionText}" />
    -->
    <target xsi:type="WdColoredConsole" name="console" />

    <!-- 一般 log：每天一個檔案，保留 30 天 -->
    <target xsi:type="File" name="mainFile"
            fileName="${logDir}/wdbot-${date:format=yyyyMMdd}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${level:format=TriLetter:uppercase=true}] ${logger}: ${message}${exceptionText}"
            encoding="utf-8"
            maxArchiveDays="30" />

    <!-- 收到的私訊內容：logs/messages/{bot_id}/messages-日期.log -->
    <target xsi:type="File" name="privateFile"
            fileName="${messageDir}/${botFolder}/messages-${date:format=yyyyMMdd}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} ${message}"
            encoding="utf-8"
            maxArchiveDays="30" />

    <!-- 公頻訊息內容：logs/messages/{bot_id}/channel-日期.log -->
    <target xsi:type="File" name="channelFile"
            fileName="${messageDir}/${botFolder}/channel-${date:format=yyyyMMdd}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} ${message}"
            encoding="utf-8"
            maxArchiveDays="30" />

    <!-- 程式沒有處理的聊天 WS 推送：logs/messages/{bot_id}/unhandled-日期.log -->
    <target xsi:type="File" name="unhandledFile"
            fileName="${messageDir}/${botFolder}/unhandled-${date:format=yyyyMMdd}.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${level:format=TriLetter:uppercase=true}] ${message}"
            encoding="utf-8"
            maxArchiveDays="30" />
  </targets>

  <rules>
    <!-- 訊息內容只寫進各自的檔案，不進主控台與一般 log（final 表示比對到就不再往下） -->
    <logger name="WdBot.Messages.Private" writeTo="privateFile" final="true" />
    <logger name="WdBot.Messages.Channel" writeTo="channelFile" final="true" />
    <logger name="WdBot.Messages.Unhandled" writeTo="unhandledFile" final="true" />
    <logger name="WdBot.Messages.*" final="true" />

    <logger name="*" writeTo="console,mainFile" />
  </rules>
</nlog>
